# === Secrets (JAMAIS versionnés) ===
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# === Données ===
# On ne versionne pas les exports réels ni les sorties générées.
data/samples/*
!data/samples/.gitkeep
!data/samples/README.md
data/outputs/*
!data/outputs/.gitkeep
# Les fixtures (données de test simulées) SONT versionnées.

# === Python ===
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# === Fichiers Office temporaires ===
~$*.xlsx
~$*.docx
~$*.pptx

