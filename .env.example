# ============================================================
# Bench — variables d'environnement (MODÈLE)
# Copier ce fichier en `.env` et remplir les valeurs réelles.
# `.env` est ignoré par Git : ne JAMAIS y committer de secret.
# ============================================================

# --- Anthropic / Claude (si appels API programmatiques ultérieurs) ---
ANTHROPIC_API_KEY=

# --- Apify (couche de collecte concurrente — Phase 3+) ---
APIFY_TOKEN=

# --- Cultura : accès catalogue interne (Phase 7, sous réserve d'autorisation) ---
# Aucune de ces intégrations n'est validée. Ne rien connecter sans accord explicite.
CULTURA_MIRAKL_API_URL=
CULTURA_MIRAKL_API_KEY=
CULTURA_MAGENTO_API_URL=
CULTURA_MAGENTO_API_KEY=

# --- Paramètres de run ---
# Devise et base de comparaison par défaut (voir docs/BENCH_METHOD.md)
BENCH_DEFAULT_CURRENCY=EUR
BENCH_PRICE_BASIS=TTC
